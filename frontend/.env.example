# Copy this file to .env.local and change the values if needed.

# Development: where `npm run dev` forwards /api and /static requests (the Node.js backend).
VITE_DEV_API_TARGET=http://localhost:8000

# Production build: full address of the backend, e.g. https://api.plantify.example
# (add this site's address to the backend's CORS_ORIGINS).
# Leave empty when the backend serves this app from the same domain.
VITE_API_BASE_URL=
