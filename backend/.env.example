# Copy to backend/.env and fill in. `npm start` loads it automatically (never commit .env).

# Chat assistant (RAG) — Gemini writes the answer from the retrieved passages.
# Get a key at https://aistudio.google.com/apikey. Without it the chat still works,
# but answers with the best-matching passage only.
GEMINI_API_KEY=
# Gemini model id. Default gemini-3.5-flash-lite (0.5-1.3 s per answer in testing). gemini-2.5-flash
# also works (~2 s) but its free tier allows only 20 requests a day; the gemini-3.x Flash models were
# overloaded when tested (503 errors, 50-140 s answers).
GEMINI_MODEL=gemini-3.5-flash-lite

# Server
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# Python that has the packages in src/ml/requirements.txt (XGBoost model + chat retrieval).
# Leave empty to use backend/.venv, ../.venv, or python3 / python on PATH.
PYTHON_BIN=
